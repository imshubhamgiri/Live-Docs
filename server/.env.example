# Bright Data API key (Scraper Studio / Web Scraper API)
BRIGHTDATA_API_KEY=bd_your_brightdata_api_key_here

# Pinecone vector database (RAG embeddings)
PINECONE_API_KEY=pcsk_your_pinecone_api_key_here
PINECONE_INDEX_NAME=docs-rag

# Groq LLM key (grounded chat inference, free tier)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Redis (BullMQ queue + pub/sub). Docker uses host.docker.internal
REDIS_URL=redis://localhost:6379

# MongoDB connection (code reads MONGO_URI, see config/mongose.db.ts)
MONGO_URI=mongodb://localhost:27017/live-docs